############################
# Secrets / Environment
############################
.env
.env.*
.env.local

############################
# Python virtual env
############################
.venv/
venv/
env/

############################
# Python cache
############################
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

############################
# Build artifacts
############################
dist/
build/

############################
# Data Engineering layers
############################
# Raw source CSV (Kaggle)
data/raw/

# Layered tables (non versionate)
data/bronze/
data/silver/
data/gold/

# Ignore everything under data/ by default
data/*

# BUT allow the DuckDB snapshot for Streamlit Cloud
!data/warehouse.duckdb


############################
# DuckDB & Parquet (global ignore)
############################
*.duckdb
*.parquet

# Re-allow ONLY the demo DuckDB
!data/warehouse.duckdb


############################
# Data Lake (Fase 2)
############################
# Ignore all data lake by default
data_lake/*

# Re-allow the folder structure
!data_lake/
!data_lake/raw/
!data_lake/raw/**

# Re-allow ONLY parquet batches in raw
!data_lake/raw/**/*.parquet


############################
# CSV (except raw source)
############################
*.csv

############################
# Streamlit
############################
.streamlit/credentials.toml
.streamlit/secrets.toml

############################
# VS Code
############################
.vscode/

############################
# OS files
############################
.DS_Store
Thumbs.db

############################
# Misc
############################
.cache/
*.log
